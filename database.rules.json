{
  "rules": {
    "users": {
      "$uid": {
        "devices": {
          "$deviceId": {
            "liveState": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['deviceId', 'observedAt', 'blinkRatePerMinute', 'eyeClosureRatio', 'status'])",
              "deviceId": {
                ".validate": "newData.isString() && newData.val() === $deviceId"
              },
              "observedAt": {
                ".validate": "newData.isString()"
              },
              "blinkRatePerMinute": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
              },
              "eyeClosureRatio": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "status": {
                ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'inactive')"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "sessions": {
          "$sessionId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "insights": {
          "$insightId": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}