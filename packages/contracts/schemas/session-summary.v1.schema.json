{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blink.example/contracts/session-summary.v1.schema.json",
  "title": "SessionSummary",
  "description": "Immutable eye-health metrics recorded during a completed Blink session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "deviceId",
    "userId",
    "startedAt",
    "endedAt",
    "durationSeconds",
    "totalBlinks",
    "averageBpm",
    "nudgeCount",
    "schemaVersion"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "userId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "totalBlinks": {
      "type": "integer",
      "minimum": 0
    },
    "averageBpm": {
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "minBpm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "maxBpm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "nudgeCount": {
      "type": "integer",
      "minimum": 0
    },
    "adherenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
