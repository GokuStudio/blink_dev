{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blink.example/contracts/live-device-state.v1.schema.json",
  "title": "LiveDeviceState",
  "description": "Current eye-wellness telemetry reported by one Blink device.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "observedAt",
    "blinkRatePerMinute",
    "eyeClosureRatio",
    "status"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "blinkRatePerMinute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "eyeClosureRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive"]
    }
  }
}
