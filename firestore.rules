rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidTimestampString(val) {
      return val is string && val.size() >= 19;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'updatedAt', 'displayName', 'email', 'isAnonymous', 'preferences'])
        && request.resource.data.uid == uid;

      // Registered devices owned by this user
      match /devices/{deviceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.deviceId == deviceId
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() > 0
          && request.resource.data.deviceId.size() <= 128
          && request.resource.data.keys().hasOnly(['deviceId', 'model', 'firmwareVersion', 'nickname', 'registeredAt', 'status'])
          && request.resource.data.status in ['active', 'inactive', 'paired'];
        allow delete: if isOwner(uid);
      }

      // Finalized session summaries
      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.sessionId == sessionId
          && request.resource.data.userId == uid
          && request.resource.data.deviceId is string
          && isValidTimestampString(request.resource.data.startedAt)
          && isValidTimestampString(request.resource.data.endedAt)
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds >= 0
          && request.resource.data.totalBlinks is int
          && request.resource.data.totalBlinks >= 0
          && request.resource.data.averageBpm is number
          && request.resource.data.averageBpm >= 0
          && request.resource.data.averageBpm <= 120
          && request.resource.data.nudgeCount is int
          && request.resource.data.nudgeCount >= 0
          && request.resource.data.schemaVersion is string
          && request.resource.data.keys().hasAll([
            'sessionId', 'deviceId', 'userId', 'startedAt', 'endedAt',
            'durationSeconds', 'totalBlinks', 'averageBpm', 'nudgeCount', 'schemaVersion'
          ])
          && request.resource.data.keys().hasOnly([
            'sessionId', 'deviceId', 'userId', 'startedAt', 'endedAt',
            'durationSeconds', 'totalBlinks', 'averageBpm', 'minBpm',
            'maxBpm', 'nudgeCount', 'adherenceScore', 'schemaVersion', 'createdAt'
          ]);
        // Historical sessions are immutable once created
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // Pre-aggregated daily summaries for fast trend rendering
      match /daily_summaries/{dateStr} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == dateStr
          && request.resource.data.userId == uid
          && request.resource.data.totalDurationSeconds is int
          && request.resource.data.totalDurationSeconds >= 0
          && request.resource.data.totalBlinks is int
          && request.resource.data.totalBlinks >= 0
          && request.resource.data.averageBpm is number
          && request.resource.data.averageBpm >= 0
          && request.resource.data.averageBpm <= 120
          && request.resource.data.totalNudges is int
          && request.resource.data.totalNudges >= 0
          && request.resource.data.sessionCount is int
          && request.resource.data.sessionCount >= 0
          && request.resource.data.keys().hasOnly([
            'date', 'userId', 'totalDurationSeconds', 'totalBlinks',
            'averageBpm', 'totalNudges', 'sessionCount', 'updatedAt', 'schemaVersion'
          ]);
        allow delete: if isOwner(uid);
      }

      // Preserving backward compatibility with existing insights path
      match /insights/{insightId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
