# Firebase configuration template for Blink Companion
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-blink.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-blink
EXPO_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-blink
EXPO_PUBLIC_FIREBASE_USE_EMULATORS=true
# Use 10.0.2.2 for Android emulator, 127.0.0.1 for Web/iOS simulator, or your local machine LAN IP for a physical device
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
